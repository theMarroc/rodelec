{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rodelec",
  "compatibility_date": "2026-09-21",

  // Sitio estático puro: no hay script de Worker, solo los archivos de dist.
  "assets": {
    "directory": "./dist/",
    // Cualquier ruta que no sea un archivo real (/staff, /servicios) devuelve
    // index.html con 200 para que React Router la resuelva del lado del cliente.
    // Reemplaza al public/_redirects, que es sintaxis de Cloudflare Pages y
    // Workers rechaza por bucle infinito (error 100324).
    "not_found_handling": "single-page-application"
  }
}
